#:culture{:id "nga.dish.jollof-rice", :name "Jollof rice", :country "NGA", :kind :dish, :summary "West African rice dish with disputed origins; Wikipedia identifies Senegal as the historical source, while Nigeria is known for a distinct regional variation and the long-running \"Jollof Wars\" rivalry with Ghana over whose version is best.", :url "https://en.wikipedia.org/wiki/Jollof_rice", :url-provenance :wikipedia-en, :retrieved-at "2026-07-17"}
#:culture{:id "nga.dish.suya", :name "Suya", :country "NGA", :kind :dish, :summary "Traditional Hausa smoke-grilled spiced meat on skewers, with place of origin Nigeria; described as having become a Nigerian national dish.", :url "https://en.wikipedia.org/wiki/Suya", :url-provenance :wikipedia-en, :retrieved-at "2026-07-17"}
#:culture{:id "nga.dish.egusi", :name "Egusi", :country "NGA", :kind :dish, :summary "Protein-rich melon seeds used across West African cuisine, prepared as soup or stew; the article states egusi is common throughout Nigeria and rooted in Yoruba culinary tradition.", :url "https://en.wikipedia.org/wiki/Egusi", :url-provenance :wikipedia-en, :retrieved-at "2026-07-17"}
#:culture{:id "nga.dish.pounded-yam", :name "Pounded yam", :country "NGA", :kind :dish, :summary "Nigerian swallow food made by pounding boiled yam with a mortar and pestle, a staple among the Hausa, Igbo and Yoruba peoples, eaten with soups such as egusi or okra soup.", :url "https://en.wikipedia.org/wiki/Pounded_yam", :url-provenance :wikipedia-en, :retrieved-at "2026-07-17"}
#:culture{:id "nga.beverage.chapman", :name "Chapman", :country "NGA", :kind :beverage, :summary "Non-alcoholic mixed drink originating in Nigeria, believed created at the Ikoyi Club in Lagos by bartender Samuel Alamutu; widely described as Nigeria's favourite drink.", :url "https://en.wikipedia.org/wiki/Chapman_(drink)", :url-provenance :wikipedia-en, :retrieved-at "2026-07-17"}
#:culture{:url "https://en.wikipedia.org/wiki/Adire_(textile_art)", :id "nga.craft.adire", :kind :craft, :name-local "Àdìrẹ", :country "NGA", :retrieved-at "2026-07-17", :summary "Resist-dyed cloth traditionally made by Yoruba women in south-western Nigeria, using techniques such as tying and cassava-paste stencilling; Abeokuta is considered the capital of adire-making.", :name "Adire", :url-provenance :wikipedia-en}
#:culture{:url "https://en.wikipedia.org/wiki/Eyo_festival", :id "nga.festival.eyo", :kind :festival, :name-local "Adamu Orisha Play", :country "NGA", :retrieved-at "2026-07-17", :summary "Yoruba festival unique to Lagos, Nigeria, historically a secret-society ritual to escort a departed king's soul to the afterlife and usher in a new leader, now also presented as a tourist event.", :name "Eyo festival", :url-provenance :wikipedia-en}
#:culture{:id "nga.heritage.osun-osogbo-sacred-grove", :name "Osun-Osogbo Sacred Grove", :country "NGA", :kind :heritage, :summary "Sacred grove along the Osun river outside Osogbo, Osun State, Nigeria, inscribed as a UNESCO World Heritage Site in 2005 for its cultural significance.", :url "https://en.wikipedia.org/wiki/Osun-Osogbo_Sacred_Grove", :url-provenance :wikipedia-en, :retrieved-at "2026-07-17"}
